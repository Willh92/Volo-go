# ==============================================================================
# Volo-go Configuration (.env.example)
# Precedence: CLI Flags > System Env (VOLO_*) > .env File > Secure Defaults
# Zero-config ready: Volo-go starts safely out-of-the-box without a .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network Listener & Public Identity
# ------------------------------------------------------------------------------
# TCP listen address (ignored when VOLO_LISTEN_SOCKET is set)
VOLO_LISTEN_ADDR=0.0.0.0:8080

# Unix Domain Socket listener with optional octal permission bits (default 0660)
# and socket group ownership (e.g. www-data on Debian/Ubuntu, nginx on RHEL).
# Format: /path/to/volo.sock (or /path/to/volo.sock,0660)
# When set, TCP listener is disabled, parent dir safety is verified, and a 0600
# .sock.lock file lock is acquired.
VOLO_LISTEN_SOCKET=
VOLO_SOCKET_MODE=0660
VOLO_SOCKET_GROUP=

# Canonical public URL of your blog (used for canonical links, RSS/Podcast,
# Sitemap, WebAuthn RP Origin, IndexNow, and outbound email links).
VOLO_PUBLIC_URL=http://localhost:8080

# Comma-separated list of trusted reverse proxy IPs, CIDRs, or literal "unix"
# (when VOLO_LISTEN_SOCKET is active). Empty means trust NO forwarding headers.
# Client IP is resolved strictly from X-Real-IP only when peer matches this list.
VOLO_TRUSTED_PROXIES=127.0.0.1,::1

# ------------------------------------------------------------------------------
# 2. Security, Cloaked Admin Entry & Emergency Circuit Breakers
# ------------------------------------------------------------------------------
# Custom hidden admin console prefix (must start with /, e.g. /studio-gate).
# When customized from default (/console), all default admin/login paths
# (/console, /login, /admin, /start) return indistinguishable 404 responses
# and feed the scanner risk-control tracker.
VOLO_ADMIN_PATH=/console

# High-entropy master secret (>= 32 chars recommended).
# Derives isolated HKDF-SHA256 subkeys for AES-256-GCM DB credential encryption,
# HMAC GuestPassport signing, env_fp peppering, ShareToken, and Session CSRF.
# If left empty, Volo-go automatically generates a 32-byte random secret into
# ${VOLO_DATA_DIR}/.secret.key with strict 0600 permissions.
VOLO_SECRET_KEY=

# Offline GeoIP access control circuit breaker.
# Set to false and restart if an admin accidentally locks out their changed IP
# via region rules; disables enforcement without deleting saved DB rules.
VOLO_GEO_ACCESS_ENABLED=true

# Graceful shutdown drain timeout in seconds (1-120; CLI flag: --shutdown-timeout)
VOLO_SHUTDOWN_TIMEOUT_SEC=15

# ------------------------------------------------------------------------------
# 3. Localization (i18n) & Filesystem Directories
# ------------------------------------------------------------------------------
# Fallback default site & system locale (built-in: zh-CN, en-US; extensible via VOLO_LOCALES_DIR)
VOLO_DEFAULT_LOCALE=zh-CN

# Base runtime data directory (SQLite DB, .secret.key, logs)
VOLO_DATA_DIR=./data

# Local uploaded media assets directory
VOLO_UPLOAD_DIR=./data/uploads

# Local rolling backup archive directory
VOLO_BACKUP_DIR=./data/backups

# Offline GeoIP database directory (GeoLite2-City.mmdb / GeoIP2-City.mmdb / ip2region_v4.xdb / ip2region_v6.xdb)
VOLO_GEOIP_DIR=./data/geoip

# External hot-mountable themes directory (overrides or supplements built-in volo-studio)
VOLO_THEMES_DIR=./themes

# External hot-pluggable plugins directory (manifest.json + pure-Go goja ES6 runtime)
VOLO_PLUGINS_DIR=./plugins

# External locale JSON packs directory (supplements or overrides built-in zh-CN / en-US)
VOLO_LOCALES_DIR=./locales

# ------------------------------------------------------------------------------
# 4. Multi-Dialect Database Engine (Pure-Go Drivers, CGO_ENABLED=0)
# ------------------------------------------------------------------------------
# Supported drivers: sqlite | postgres | mysql
# Leave VOLO_DB_DRIVER unset (commented out) so the `/setup` wizard's saved
# choice in ${VOLO_DATA_DIR}/db.json (SQLite / PostgreSQL / MySQL) takes effect
# across restarts; setting VOLO_DB_DRIVER explicitly overrides db.json!
# VOLO_DB_DRIVER=sqlite

# Driver-specific DSN examples:
# - SQLite (default if empty): ./data/volo.db
# - PostgreSQL / Supabase / Neon / CockroachDB:
#   postgres://user:password@127.0.0.1:5432/volo?sslmode=verify-full
# - MySQL 8+ / MariaDB / TiDB:
#   user:password@tcp(127.0.0.1:3306)/volo?charset=utf8mb4&parseTime=true&loc=UTC&tls=true
VOLO_DB_DSN=

# Enable PostgreSQL simple query protocol (set true for Supabase/PgBouncer transaction poolers)
VOLO_DB_SIMPLE_PROTOCOL=false

# Connection pool tuning for PostgreSQL / MySQL (ignored on SQLite single-writer channel;
# valid ranges: MAX_OPEN_CONNS 1-500, MAX_IDLE_CONNS 0-500, CONN_MAX_LIFETIME_SEC 10-86400)
VOLO_DB_MAX_OPEN_CONNS=25
VOLO_DB_MAX_IDLE_CONNS=5
VOLO_DB_CONN_MAX_LIFETIME_SEC=1800
