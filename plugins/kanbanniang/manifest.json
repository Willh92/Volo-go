{
  "id": "kanbanniang",
  "version": "2.0.0",
  "min_host_version": "0.1.0",
  "runtime": "goja",
  "entry": "main.js",
  "author": "Volo Studio",
  "homepage": "https://github.com/Willh92/Volo-go",
  "name": {
    "zh-CN": "工作室看板娘 (Live2D Mascot)",
    "en-US": "Studio Live2D Mascot",
    "zh-TW": "工作室看板娘 (Live2D Mascot)",
    "ja-JP": "スタジオ看板娘 (Live2D Mascot)"
  },
  "description": {
    "zh-CN": "本地化 WebGL Live2D 互动看板娘插件，内置 26 套经典模型与随机换装、樱花动态背景、拖拽记忆、PJAX 跨页常驻及摸头统计。",
    "en-US": "Self-hosted WebGL Live2D interactive mascot with 26 local models, costume switching, sakura backgrounds, drag memory, PJAX persistence, and head-pat stats.",
    "zh-TW": "本地化 WebGL Live2D 互動看板娘外掛，內建 26 套經典模型與隨機換裝、櫻花動態背景、拖曳記憶、PJAX 跨頁常駐及摸頭統計。",
    "ja-JP": "ローカルWebGL Live2Dインタラクティブ看板娘プラグイン。26種類のモデルと着せ替え、桜アニメーション背景、ドラッグ位置記憶、PJAX常駐、なでなで統計に対応。"
  },
  "permissions": [
    "kv",
    "ratelimit",
    "site:read",
    "slots:public.footer",
    "slots:admin.dashboard_card",
    "http:routes"
  ],
  "ui_slots": [
    {
      "slot": "public.footer",
      "persist": true,
      "dynamic": true,
      "style_asset": "widget.css",
      "script_asset": "widget.js"
    },
    {
      "slot": "admin.dashboard_card",
      "dynamic": true
    }
  ],
  "config_schema": [
