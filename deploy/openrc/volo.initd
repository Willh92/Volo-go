#!/sbin/openrc-run
# Volo-go OpenRC init script (Alpine Linux / Gentoo)

name="Volo-go"
description="Volo-go Pure-Go Sovereign Blog Engine"

command="/usr/local/bin/volo"
command_args="serve"
command_user="${VOLO_USER:-volo}:${VOLO_GROUP:-volo}"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
directory="/var/lib/volo"
output_log="/var/log/volo/volo.log"
error_log="/var/log/volo/volo.err"
stopsig="SIGTERM"
retry="SIGTERM/20/SIGKILL/5"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --directory --owner "${command_user}" --mode 0750 /var/lib/volo /var/log/volo
    checkpath --directory --owner "${command_user}" --mode 0755 /run/volo
    if [ -r /etc/volo/volo.env ]; then
        set -a
        # shellcheck disable=SC1091
        . /etc/volo/volo.env
        set +a
    fi
}
