[Unit]
Description=Volo-go Pure-Go Sovereign Blog Engine
Documentation=https://github.com/Willh92/Volo-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=volo
Group=volo
WorkingDirectory=/var/lib/volo
EnvironmentFile=-/etc/volo/volo.env
ExecStart=/usr/local/bin/volo serve --env-file /etc/volo/volo.env
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=3

# Persistent runtime directory across reboots for Unix Domain Socket (/run/volo/volo.sock).
# When sharing the socket with nginx/caddy (VOLO_SOCKET_GROUP=www-data, VOLO_SOCKET_MODE=0660),
# add `SupplementaryGroups=www-data` via `sudo systemctl edit volo` (or use scripts/install-service.sh).
RuntimeDirectory=volo
RuntimeDirectoryMode=2750

# File descriptor & process limits
LimitNOFILE=65536

# Systemd sandboxing & privilege hardening
# Note: scripts/install-service.sh automatically resolves symlinks and adapts ReadWritePaths,
# ProtectHome, and PrivateTmp for custom install/data/socket paths. When editing manually:
#   [Service]
#   ReadWritePaths=/custom/real/data/path /custom/real/socket/parent
#   ProtectHome=false    # required if binary, data, or socket lives under /home or /root
#   PrivateTmp=false     # required if data or socket lives under /tmp or /var/tmp
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027
ReadWritePaths=/var/lib/volo /run/volo

[Install]
WantedBy=multi-user.target
